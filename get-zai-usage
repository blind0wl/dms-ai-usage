#!/usr/bin/env bash
# The Account origins this script reports are display text: the path, directory
# or environment variable a credential was found at, in the form the plugin's
# own descriptions already use. A tilde in one is meant literally, not as a
# shell expansion to perform.
# shellcheck disable=SC2088
set -eu

# A Requirement is a command-line program this Script cannot read any data
# without. plugin.json declares them, and the check runs before anything else:
# with a Requirement absent nothing downstream can be read, so a swallowed jq
# failure would report a credential verdict instead of naming the real cause
# (ADR 0005).
#
# The names are read from the manifest with sed and tr rather than jq, because
# the program doing the checking is the one that may be missing. Presence only: a
# jq that exists and fails is the call's own business and reports Blocked from
# where it fails.
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)

requirement_names() {
    sed -n '/"requires"[[:space:]]*:[[:space:]]*\[/,/\]/p' "$1" \
        | tr -d '[:space:]"' \
        | sed -e '1s/^[^:]*://' -e 's/[][]//g' \
        | tr ',' '\n' \
        | sed '/^$/d'
}

missing_requirements() {
    local name out=""
    while IFS= read -r name; do
        [ -n "$name" ] || continue
        command -v "$name" >/dev/null 2>&1 || out="${out:+$out,}$name"
    done < <(requirement_names "$SCRIPT_DIR/plugin.json")
    printf '%s' "$out"
}

# The report a Script emits when it cannot read a credential: the state, the
# commands that blocked it, and an empty Account list so a listing parses. The
# origins and shadowed keys answer only the listing, which asks for them.
blocked_report() {
    local commands="$1"
    shift
    printf 'CREDS_STATUS=blocked\n'
    printf 'BLOCKING_REQUIREMENT=%s\n' "$commands"
    printf 'ACCOUNTS=\n'
    for arg in "$@"; do
        if [ "$arg" = "--list-accounts" ]; then
            printf 'ACCOUNT_ORIGINS=\n'
            printf 'ACCOUNT_SHADOWED=\n'
            break
        fi
    done
}

MISSING_REQUIREMENTS=$(missing_requirements)
if [ -n "$MISSING_REQUIREMENTS" ]; then
    # No credential is read and no request is made.
    blocked_report "$MISSING_REQUIREMENTS" "$@"
    exit 0
fi

# The value of one line in a result file, or the given default when the line is
# absent or empty. The default is applied outside the pipeline that reads the
# value, because `grep | cut || echo` binds `||` to cut, whose exit status is 0
# even when grep matched nothing (#59).
result_value() {
    local file="$1" key="$2" default="$3" value
    value=$(grep "^${key}=" "$file" 2>/dev/null | cut -d= -f2-)
    printf '%s' "${value:-$default}"
}

# Write a result file all-or-nothing: a reader sees the whole file or none of it,
# never a half-written one. The temporary sits beside the destination, so the
# rename that publishes it is atomic.
write_usage_result() {
    local out_file="$1"
    shift
    local tmp="${out_file}.tmp.$$"
    if printf '%s\n' "$@" 2>/dev/null > "$tmp"; then
        mv -f "$tmp" "$out_file" 2>/dev/null || rm -f "$tmp"
    else
        rm -f "$tmp"
    fi
}

# Calendar week: Monday to Sunday, and month-to-date from the 1st. The API
# takes date strings, so both windows are expressed as local calendar dates.
DOW=$(date +%u)  # 1=Monday, 7=Sunday
WEEK_START=$(date -d "$((DOW - 1)) days ago" +%Y-%m-%d)
MONTH_START=$(date +%Y-%m-01)
TODAY=$(date +%Y-%m-%d)

API_BASE="https://api.z.ai/api/monitor/usage"

# --- Account list: name + api key + where the key was found ---
ACCOUNT_NAMES=()
ACCOUNT_KEYS=()
ACCOUNT_ORIGINS=()
ACCOUNT_SHADOWED=()

# add_account <name> <api-key> <origin>
# First registration of a name (or of a key) wins, so the argv entries added
# before the pi/env fallbacks take priority over them. The origin is where the
# key was found, as the user would look for it: a file's path, the name of an
# environment variable, or "custom" for an entry from the plugin's Custom
# Account list. It is display text, so the two list delimiters are stripped
# from it just as they are from a name.
add_account() {
    local name="$1" key="$2" origin="${3:-}"

    # , | : are output delimiters, they cannot survive in an account name. An
    # origin is display text: the list it rides is comma-separated and the other
    # Account lists separate entries with |, so neither can survive in it either.
    # The ":" that separates an origin from its name is left alone, because a
    # pair is split on its first colon and a path may carry one.
    name="${name//[,|:]/}"
    origin="${origin//[,|]/}"
    [ -n "$name" ] || return 0
    [ -n "$key" ] || return 0

    local idx
    # Nothing to clash with while the list is empty, and the guard keeps that
    # true on a bash that cannot expand an empty indexed list under set -u.
    if [ "${#ACCOUNT_NAMES[@]}" -gt 0 ]; then
        for idx in "${!ACCOUNT_NAMES[@]}"; do
            if [ "${ACCOUNT_NAMES[$idx]}" = "$name" ] || [ "${ACCOUNT_KEYS[$idx]}" = "$key" ]; then
                # Only a clash a user can act on is reported: one side of it has
                # to be a Custom Account. Two detected registrations clashing is
                # the Script's own precedence, which its description explains.
                if [ "$origin" = "custom" ] || [ "${ACCOUNT_ORIGINS[$idx]}" = "custom" ]; then
                    ACCOUNT_SHADOWED+=("${ACCOUNT_NAMES[$idx]}|${name}:${origin}")
                fi
                return 0
            fi
        done
    fi

    ACCOUNT_NAMES+=("$name")
    ACCOUNT_KEYS+=("$key")
    ACCOUNT_ORIGINS+=("$origin")
}

# account_origins -> "name:origin,name:origin". The form the per-Account lists
# already use, so the settings page parses one shape.
account_origins() {
    local out="" idx
    # An empty list has nothing to join, and the guard keeps the expansion valid
    # on a bash that cannot expand an empty indexed list under set -u.
    if [ "${#ACCOUNT_NAMES[@]}" -gt 0 ]; then
        for idx in "${!ACCOUNT_NAMES[@]}"; do
            out="${out:+${out},}${ACCOUNT_NAMES[$idx]}:${ACCOUNT_ORIGINS[$idx]}"
        done
    fi
    printf '%s' "$out"
}

# account_shadowed -> "<winner>|<name>:<origin>" for the registrations the list
# refused because something already held their name or their value: what kept it,
# then what lost and where it came from. The settings page is how the user learns
# that a Custom Account took a detected one's place, which is otherwise only
# visible as an API rejection. The winner makes that link explicit even when the
# two names differ, as they do when the value is what clashed.
account_shadowed() {
    local out="" idx
    # An empty list has nothing to join, and the guard keeps the expansion valid
    # on a bash that cannot expand an empty indexed list under set -u.
    if [ "${#ACCOUNT_SHADOWED[@]}" -gt 0 ]; then
        for idx in "${!ACCOUNT_SHADOWED[@]}"; do
            out="${out:+${out},}${ACCOUNT_SHADOWED[$idx]}"
        done
    fi
    printf '%s' "$out"
}

LIST_ACCOUNTS=0

for arg in "$@"; do
    case "$arg" in
        "--list-accounts") LIST_ACCOUNTS=1 ;;
        *=*) add_account "${arg%%=*}" "${arg#*=}" "custom" ;;
    esac
done

PI_MODELS="${HOME}/.pi/agent/models.json"
pi_key=""
if [ -f "$PI_MODELS" ]; then
    # A jq that fails reading the config must not read as the file lacking the
    # key: one is Blocked, the other is simply no Account there (ADR 0005).
    if ! pi_key=$(jq -r '.providers.zai.apiKey // ""' "$PI_MODELS" 2>/dev/null); then
        blocked_report "jq" "$@"
        exit 0
    fi
    [ -n "$pi_key" ] && add_account "default" "$pi_key" "~/.pi/agent/models.json"
fi
[ -n "${ZAI_API_KEY:-}" ] && add_account "default" "$ZAI_API_KEY" "ZAI_API_KEY"

# The settings page's Account editor asks for the list on its own, with the same
# name=value arguments the widget fetches with so that the two agree about which
# Account a name refers to. This returns before the first request: opening the
# settings page must not spend an API call.
if [ "$LIST_ACCOUNTS" -eq 1 ]; then
    # The listing answer says why it is empty when it is: an empty Account list
    # is this Script's own Not installed state, and the settings page needs to
    # know that as a state of the Source rather than as a verdict on the user's
    # rows.
    printf 'ACCOUNTS=%s\n' "$(IFS=,; echo "${ACCOUNT_NAMES[*]:-}")"
    printf 'ACCOUNT_ORIGINS=%s\n' "$(account_origins)"
    printf 'ACCOUNT_SHADOWED=%s\n' "$(account_shadowed)"
    if [ "${#ACCOUNT_NAMES[@]}" -eq 0 ]; then
        printf 'CREDS_STATUS=not_installed\n'
    fi
    exit 0
fi

# Z.ai is an API-key service with no local binary or config of its own, so
# "no credentials anywhere" is the equivalent of the other Sources' missing
# binary: the Source isn't logged out, it isn't in use at all, and the widget
# hides it entirely rather than offering a login card.
if [ "${#ACCOUNT_NAMES[@]}" -eq 0 ]; then
    cat <<'NOTINSTALLED'
PLAN_TYPE=unknown
PRIMARY_UTIL=0
PRIMARY_RESET=
PRIMARY_WINDOW_SECONDS=0
SECONDARY_UTIL=0
SECONDARY_RESET=
SECONDARY_WINDOW_SECONDS=0
CREDS_STATUS=not_installed
WEEK_TOKENS=0
WEEK_CALLS=0
MONTH_TOKENS=0
DAILY=0,0,0,0,0,0,0
WEEK_MODELS=
ACCOUNTS=
ACCOUNT_ORIGINS=
ACCOUNT_SHADOWED=
NOTINSTALLED
    exit 0
fi

# --- Per-account quota + server-side usage fetcher ---
# Usage: fetch_account_usage <api-key> <out_tmpfile>
# Writes PLAN_TYPE, PRIMARY_*, SECONDARY_*, CREDS_STATUS, WEEK_TOKENS,
# WEEK_CALLS, MONTH_TOKENS, DAILY, WEEK_MODELS to out_tmpfile.
fetch_account_usage() {
    local key="$1"
    local out_file="$2"

    local plan_type="unknown"
    local primary_util=0 primary_reset="" primary_window=0
    local secondary_util=0 secondary_reset="" secondary_window=0
    local creds_status="missing"
    local week_tokens=0 week_calls=0 month_tokens=0
    local daily="0,0,0,0,0,0,0" week_models=""

    write_out() {
        write_usage_result "$out_file" \
            "PLAN_TYPE=$plan_type" \
            "PRIMARY_UTIL=$primary_util" \
            "PRIMARY_RESET=$primary_reset" \
            "PRIMARY_WINDOW_SECONDS=$primary_window" \
            "SECONDARY_UTIL=$secondary_util" \
            "SECONDARY_RESET=$secondary_reset" \
            "SECONDARY_WINDOW_SECONDS=$secondary_window" \
            "CREDS_STATUS=$creds_status" \
            "WEEK_TOKENS=$week_tokens" \
            "WEEK_CALLS=$week_calls" \
            "MONTH_TOKENS=$month_tokens" \
            "DAILY=$daily" \
            "WEEK_MODELS=$week_models"
    }

    # A failure report carries only the lines the fetch actually has: the status,
    # and the Requirement for a Blocked one. The Window lines are left out rather
    # than written as zero, and the Source-level report drops them too, so a
    # failure is never presented as a fresh Window reading.
    write_failure() {
        if [ "$creds_status" = "blocked" ]; then
            write_usage_result "$out_file" "CREDS_STATUS=blocked" "BLOCKING_REQUIREMENT=jq"
        else
            write_usage_result "$out_file" "CREDS_STATUS=$creds_status"
        fi
    }

    # api_get <url> -> "<http_code>\n<body>". The key goes in Authorization
    # raw, with no "Bearer " prefix: z.ai rejects the prefixed form.
    api_get() {
        local url="$1" raw http body
        raw=$(curl -s --max-time 10 -w $'\n%{http_code}' \
            -H "Authorization: $key" \
            -H "Content-Type: application/json" \
            "$url" 2>/dev/null || echo "")
        http="${raw##*$'\n'}"
        body="${raw%$'\n'*}"
        [ "$raw" = "$http" ] && body=""
        printf '%s\n%s' "${http:-000}" "$body"
    }

    local quota_resp quota_http quota_body
    quota_resp=$(api_get "${API_BASE}/quota/limit")
    quota_http="${quota_resp%%$'\n'*}"
    quota_body="${quota_resp#*$'\n'}"

    # An HTTP rejection is authoritative: the key is bad whatever the body says,
    # so it is read before the body is parsed.
    if [ "$quota_http" = "401" ] || [ "$quota_http" = "403" ]; then
        creds_status="missing"
        write_out
        return
    fi

    # The response body separates the two jq failure modes (ADR 0005). A body
    # that is not valid JSON is the endpoint answering with something unexpected,
    # which is Unavailable. A jq that fails while reading a valid body is the
    # tool's own failure, which is Blocked with jq named. A known-good object is
    # validated first, so a jq too broken to parse anything is not mistaken for a
    # bad body.
    if ! printf '{}' | jq -e . >/dev/null 2>&1; then
        creds_status="blocked"
        write_failure
        return
    fi
    if ! printf '%s' "$quota_body" | jq -e . >/dev/null 2>&1; then
        creds_status="unavailable"
        write_failure
        return
    fi

    # A rejected key can also come back as HTTP 200 carrying {"code":401,
    # "success":false}, so there the body is the authority.
    local body_code body_success
    local extraction_failed=false
    body_code=$(printf '%s' "$quota_body" | jq -r '.code // 0' 2>/dev/null) || extraction_failed=true
    body_success=$(printf '%s' "$quota_body" | jq -r 'if has("success") then (.success|tostring) else "true" end' 2>/dev/null) || extraction_failed=true
    if [ "$extraction_failed" = true ]; then
        creds_status="blocked"
        write_failure
        return
    fi

    if [ "$body_code" = "401" ] || [ "$body_code" = "403" ] || [ "$body_success" = "false" ]; then
        creds_status="missing"
        write_out
        return
    fi

    local limits_present
    limits_present=$(printf '%s' "$quota_body" | jq -r 'if (.data.limits // null) == null then "no" else "yes" end' 2>/dev/null) || extraction_failed=true
    if [ "$extraction_failed" = true ]; then
        creds_status="blocked"
        write_failure
        return
    fi
    if [ "$limits_present" != "yes" ]; then
        # A valid body that is not the quota shape is the endpoint answering with
        # something the parser cannot read, not a rejected key. Nothing is known
        # about the key, so report no usage rather than inventing zeros as a
        # confirmed reading.
        creds_status="unavailable"
        write_failure
        return
    fi

    creds_status="ok"
    plan_type=$(printf '%s' "$quota_body" | jq -r '.data.level // "unknown"' 2>/dev/null) || extraction_failed=true
    [ -n "$plan_type" ] || plan_type="unknown"

    # unit identifies the window kind (3 = rolling 5h, 6 = weekly); array
    # order and the type string (CREDIT_LIMIT vs TOKENS_LIMIT, which differs
    # by plan generation) carry no meaning. nextResetTime is epoch ms and the
    # widget reads digit-only resets as seconds.
    local win
    for win in 3 6; do
        local util reset
        util=$(printf '%s' "$quota_body" | jq -r --argjson u "$win" \
            '[.data.limits[]? | select(.unit == $u)] | if length == 0 then "" else (.[0].percentage // 0 | tostring) end' 2>/dev/null) || extraction_failed=true
        reset=$(printf '%s' "$quota_body" | jq -r --argjson u "$win" \
            '[.data.limits[]? | select(.unit == $u)] | if length == 0 or (.[0].nextResetTime | not) then "" else (.[0].nextResetTime / 1000 | floor | tostring) end' 2>/dev/null) || extraction_failed=true
        # A window the API omits stays at UTIL=0 with an empty reset and a
        # zero length, which disables the countdown and pacing for it.
        if [ "$win" = 3 ]; then
            [ -n "$util" ] && { primary_util="$util"; primary_reset="$reset"; primary_window=18000; }
        else
            [ -n "$util" ] && { secondary_util="$util"; secondary_reset="$reset"; secondary_window=604800; }
        fi
    done

    if [ "$extraction_failed" = true ]; then
        creds_status="blocked"
        write_failure
        return
    fi

    local week_body month_body
    week_body=$(api_get "${API_BASE}/model-usage?startTime=${WEEK_START}+00:00:00&endTime=${TODAY}+23:59:59")
    week_body="${week_body#*$'\n'}"
    month_body=$(api_get "${API_BASE}/model-usage?startTime=${MONTH_START}+00:00:00&endTime=${TODAY}+23:59:59")
    month_body="${month_body#*$'\n'}"

    week_tokens=$(echo "$week_body" | jq -r '.data.totalUsage.totalTokensUsage // 0' 2>/dev/null || echo 0)
    week_calls=$(echo "$week_body" | jq -r '.data.totalUsage.totalModelCallCount // 0' 2>/dev/null || echo 0)
    month_tokens=$(echo "$month_body" | jq -r '.data.totalUsage.totalTokensUsage // 0' 2>/dev/null || echo 0)
    week_models=$(echo "$week_body" | jq -r '
        [.data.modelSummaryList[]? | select((.totalTokens // 0) > 0)]
        | sort_by(.sortOrder // 0)
        | map("\(.modelName)=\(.totalTokens)") | join(",")' 2>/dev/null || echo "")

    for var in week_tokens week_calls month_tokens; do
        case "${!var}" in
            ''|*[!0-9]*) printf -v "$var" '%s' 0 ;;
        esac
    done

    local day_dates="" i d
    for i in $(seq 0 6); do
        d=$(date -d "$WEEK_START + ${i} days" +%Y-%m-%d)
        day_dates="${day_dates:+${day_dates},}${d}"
    done

    # x_time labels are hourly ("YYYY-MM-DD HH:00") and index-aligned with
    # tokensUsage; the date prefix is taken as a local date.
    local bucketed
    bucketed=$(echo "$week_body" | jq -r '
        (.data.x_time // []) as $t | (.data.tokensUsage // []) as $v
        | range(0; ($t | length))
        | "\($t[.][0:10])\t\($v[.] // 0)"' 2>/dev/null \
        | awk -F'\t' -v day_dates="$day_dates" '
            BEGIN { split(day_dates, dates, ",") }
            { day[$1] += $2 + 0 }
            END {
                out = ""
                for (i = 1; i <= 7; i++) {
                    val = (dates[i] in day) ? day[dates[i]] : 0
                    out = out (i > 1 ? "," : "") val + 0
                }
                print out
            }' 2>/dev/null || echo "")
    [ -n "$bucketed" ] && daily="$bucketed"

    write_out
}

# --- Fetch per account in parallel ---
TMPDIR_ROOT=$(mktemp -d)
trap 'rm -rf "$TMPDIR_ROOT"' EXIT

USAGE_TMPFILES=()
PIDS=()

for idx in "${!ACCOUNT_KEYS[@]}"; do
    usage_tmpf=$(mktemp "$TMPDIR_ROOT/account_XXXXXX")
    USAGE_TMPFILES+=("$usage_tmpf")
    fetch_account_usage "${ACCOUNT_KEYS[$idx]}" "$usage_tmpf" &
    PIDS+=("$!")
done

for pid in "${PIDS[@]:-}"; do
    [ -n "$pid" ] && wait "$pid" || true
done

# --- Aggregate ---
PLAN_TYPE="unknown"
PRIMARY_UTIL=0
PRIMARY_RESET=""
PRIMARY_WINDOW_SECONDS=0
SECONDARY_UTIL=0
SECONDARY_RESET=""
SECONDARY_WINDOW_SECONDS=0
CREDS_STATUS="missing"
WEEK_TOKENS=0
WEEK_CALLS=0
MONTH_TOKENS=0
DAILY="0,0,0,0,0,0,0"
WEEK_MODELS=""

# Per-Account lists, in the "name:value,name2:value2" form the Claude and
# ChatGPT Sources already emit. The aggregate above keeps the Pill reading
# unchanged; these are what let the Popout report an Account on its own.
ACCOUNT_PRIMARY_UTIL=""
ACCOUNT_PRIMARY_RESET=""
ACCOUNT_SECONDARY_UTIL=""
ACCOUNT_SECONDARY_RESET=""
ACCOUNT_CREDS_STATUS=""
BLOCKING_REQUIREMENT=""

MODELS_ACC=""
DAILY_ARR=(0 0 0 0 0 0 0)

for idx in "${!USAGE_TMPFILES[@]}"; do
    usage_tmpf="${USAGE_TMPFILES[$idx]}"
    aname="${ACCOUNT_NAMES[$idx]}"
    [ -f "$usage_tmpf" ] || continue

    a_plan=$(result_value "$usage_tmpf" PLAN_TYPE unknown)
    a_pu=$(result_value "$usage_tmpf" PRIMARY_UTIL 0)
    a_pr=$(result_value "$usage_tmpf" PRIMARY_RESET "")
    a_pw=$(result_value "$usage_tmpf" PRIMARY_WINDOW_SECONDS 0)
    a_su=$(result_value "$usage_tmpf" SECONDARY_UTIL 0)
    a_sr=$(result_value "$usage_tmpf" SECONDARY_RESET "")
    a_sw=$(result_value "$usage_tmpf" SECONDARY_WINDOW_SECONDS 0)
    a_cs=$(result_value "$usage_tmpf" CREDS_STATUS missing)
    a_br=$(result_value "$usage_tmpf" BLOCKING_REQUIREMENT "")
    a_wt=$(result_value "$usage_tmpf" WEEK_TOKENS 0)
    a_wc=$(result_value "$usage_tmpf" WEEK_CALLS 0)
    a_mt=$(result_value "$usage_tmpf" MONTH_TOKENS 0)
    a_daily=$(result_value "$usage_tmpf" DAILY "0,0,0,0,0,0,0")
    a_models=$(result_value "$usage_tmpf" WEEK_MODELS "")

    # Plan/status come from the "default" account, falling back to the first
    # account when the user only configured named ones.
    if [ "$aname" = "default" ] || [ "$idx" -eq 0 ]; then
        PLAN_TYPE="$a_plan"
        CREDS_STATUS="$a_cs"
        # The command list beside the status is the default Account's, because
        # the status is: the two always describe the same report.
        BLOCKING_REQUIREMENT="$a_br"
    fi

    # Windows: the highest utilisation is the binding constraint, so its
    # reset is the one the countdown must show.
    if [ "$a_pw" -gt 0 ] && { [ "$PRIMARY_WINDOW_SECONDS" -eq 0 ] || [ "$a_pu" -gt "$PRIMARY_UTIL" ]; }; then
        PRIMARY_UTIL="$a_pu"
        PRIMARY_RESET="$a_pr"
        PRIMARY_WINDOW_SECONDS="$a_pw"
    fi
    if [ "$a_sw" -gt 0 ] && { [ "$SECONDARY_WINDOW_SECONDS" -eq 0 ] || [ "$a_su" -gt "$SECONDARY_UTIL" ]; }; then
        SECONDARY_UTIL="$a_su"
        SECONDARY_RESET="$a_sr"
        SECONDARY_WINDOW_SECONDS="$a_sw"
    fi

    WEEK_TOKENS=$(( WEEK_TOKENS + a_wt ))
    WEEK_CALLS=$(( WEEK_CALLS + a_wc ))
    MONTH_TOKENS=$(( MONTH_TOKENS + a_mt ))

    DAILY=$(echo "$a_daily" | awk -v cur="$(IFS=,; echo "${DAILY_ARR[*]}")" '
        BEGIN { split(cur, a, ",") }
        { split($0, b, ","); for(i=1;i<=7;i++) a[i]+=b[i]+0 }
        END { for(i=1;i<=7;i++) printf "%s%s", (i>1?",":""), a[i]+0; print "" }
    ')
    IFS=',' read -ra DAILY_ARR <<< "$DAILY"

    MODELS_ACC="${MODELS_ACC:+${MODELS_ACC},}${a_models}"

    # Each Account's own reading, so a rejected key cannot disappear behind a
    # healthy default. A Blocked or Unavailable Account has no reading to carry,
    # so it is left out of the Window lists rather than zeroed (ADR 0002/0005).
    ACCOUNT_CREDS_STATUS="${ACCOUNT_CREDS_STATUS:+${ACCOUNT_CREDS_STATUS},}${aname}:${a_cs}"
    if [ "$a_cs" != "unavailable" ] && [ "$a_cs" != "blocked" ]; then
        ACCOUNT_PRIMARY_UTIL="${ACCOUNT_PRIMARY_UTIL:+${ACCOUNT_PRIMARY_UTIL},}${aname}:${a_pu}"
        ACCOUNT_PRIMARY_RESET="${ACCOUNT_PRIMARY_RESET:+${ACCOUNT_PRIMARY_RESET},}${aname}:${a_pr}"
        ACCOUNT_SECONDARY_UTIL="${ACCOUNT_SECONDARY_UTIL:+${ACCOUNT_SECONDARY_UTIL},}${aname}:${a_su}"
        ACCOUNT_SECONDARY_RESET="${ACCOUNT_SECONDARY_RESET:+${ACCOUNT_SECONDARY_RESET},}${aname}:${a_sr}"
    fi

    rm -f "$usage_tmpf"
done

ACCOUNTS=$(IFS=,; echo "${ACCOUNT_NAMES[*]}")

# Sum per-model tokens across accounts, keeping the first-seen order (which
# is the API's sortOrder within each account).
WEEK_MODELS=$(echo "$MODELS_ACC" | tr ',' '\n' | grep '=' | awk -F= '
    { if (!($1 in acc)) order[++n] = $1; acc[$1] += $2 + 0 }
    END { for (i = 1; i <= n; i++) printf "%s%s=%d", (i > 1 ? "," : ""), order[i], acc[order[i]]; print "" }
' || echo "")

echo "PLAN_TYPE=${PLAN_TYPE}"
# A Blocked or Unavailable report carries no reading, so the Window keys are left
# out rather than written as zero: the widget keeps the last good reading for the
# tab and draws no ring, instead of reading a failure as a fresh zero (ADR 0002).
if [ "$CREDS_STATUS" != "blocked" ] && [ "$CREDS_STATUS" != "unavailable" ]; then
    echo "PRIMARY_UTIL=${PRIMARY_UTIL}"
    echo "PRIMARY_RESET=${PRIMARY_RESET}"
    echo "PRIMARY_WINDOW_SECONDS=${PRIMARY_WINDOW_SECONDS}"
    echo "SECONDARY_UTIL=${SECONDARY_UTIL}"
    echo "SECONDARY_RESET=${SECONDARY_RESET}"
    echo "SECONDARY_WINDOW_SECONDS=${SECONDARY_WINDOW_SECONDS}"
fi
echo "CREDS_STATUS=${CREDS_STATUS}"
# Emitted only for a Blocked report, so the other outputs are unchanged and the
# widget's own clearing of the key removes one a previous fetch left.
if [ "$CREDS_STATUS" = "blocked" ]; then
    echo "BLOCKING_REQUIREMENT=${BLOCKING_REQUIREMENT}"
fi
echo "WEEK_TOKENS=${WEEK_TOKENS}"
echo "WEEK_CALLS=${WEEK_CALLS}"
echo "MONTH_TOKENS=${MONTH_TOKENS}"
echo "DAILY=${DAILY}"
echo "WEEK_MODELS=${WEEK_MODELS}"
echo "ACCOUNTS=${ACCOUNTS}"
echo "ACCOUNT_PRIMARY_UTIL=${ACCOUNT_PRIMARY_UTIL}"
echo "ACCOUNT_PRIMARY_RESET=${ACCOUNT_PRIMARY_RESET}"
echo "ACCOUNT_SECONDARY_UTIL=${ACCOUNT_SECONDARY_UTIL}"
echo "ACCOUNT_SECONDARY_RESET=${ACCOUNT_SECONDARY_RESET}"
echo "ACCOUNT_CREDS_STATUS=${ACCOUNT_CREDS_STATUS}"
