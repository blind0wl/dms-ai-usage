#!/usr/bin/env bash
set -eu

STALE_REFRESH_DAYS=8
STALE_EXP_SECONDS=300  # 5 minutes, mirrors CodexBar's own staleness rule

# --- Decode a JWT's `exp` claim without touching the signature ---
jwt_exp() {
    local token="$1" payload mod
    payload=$(echo "$token" | cut -d. -f2)
    mod=$(( ${#payload} % 4 ))
    if [ "$mod" -eq 2 ]; then payload="${payload}=="
    elif [ "$mod" -eq 3 ]; then payload="${payload}="
    fi
    payload=$(echo "$payload" | tr -- '-_' '+/')
    echo "$payload" | base64 -d 2>/dev/null | jq -r '.exp // 0' 2>/dev/null || echo 0
}

# --- Per-account credentials + usage fetcher ---
# Usage: fetch_account_usage <codex_home_dir> <out_tmpfile>
# Writes PLAN_TYPE, PRIMARY_UTIL, PRIMARY_RESET, PRIMARY_WINDOW_SECONDS,
#        SECONDARY_UTIL, SECONDARY_RESET, SECONDARY_WINDOW_SECONDS,
#        CREDITS_BALANCE, CREDITS_HAS, CREDS_STATUS to out_tmpfile
fetch_account_usage() {
    local codex_home="$1"
    local out_file="$2"
    local auth_file="${codex_home}/auth.json"

    local plan_type="unknown"
    local primary_util=0 primary_reset="" primary_window=0
    local secondary_util=0 secondary_reset="" secondary_window=0
    local credits_balance="0" credits_has="false"
    # CREDS_STATUS: "ok" once a usage response is confirmed fresh, "expired"
    # when a token exists but the API call failed to produce one, "missing"
    # when there's no auth file (or no usable token in it) to even try.
    local creds_status="unknown"

    write_out() {
        printf 'PLAN_TYPE=%s\nPRIMARY_UTIL=%s\nPRIMARY_RESET=%s\nPRIMARY_WINDOW_SECONDS=%s\nSECONDARY_UTIL=%s\nSECONDARY_RESET=%s\nSECONDARY_WINDOW_SECONDS=%s\nCREDITS_BALANCE=%s\nCREDITS_HAS=%s\nCREDS_STATUS=%s\n' \
            "$plan_type" "$primary_util" "$primary_reset" "$primary_window" \
            "$secondary_util" "$secondary_reset" "$secondary_window" \
            "$credits_balance" "$credits_has" "$creds_status" > "$out_file"
    }

    if [ ! -f "$auth_file" ]; then
        creds_status="missing"
        write_out
        return
    fi

    local token account_id last_refresh
    token=$(jq -r '.tokens.access_token // ""' "$auth_file" 2>/dev/null || echo "")
    account_id=$(jq -r '.tokens.account_id // ""' "$auth_file" 2>/dev/null || echo "")
    last_refresh=$(jq -r '.last_refresh // ""' "$auth_file" 2>/dev/null || echo "")

    if [ -z "$token" ] || [ -z "$account_id" ]; then
        creds_status="missing"
        write_out
        return
    fi

    # Stale per CodexBar's rule: last_refresh older than 8 days, or the JWT's
    # own exp within 5 minutes. Never refresh the token ourselves here (races
    # the `codex` CLI's own writer) — shell out to `codex login status` once,
    # which triggers Codex's normal startup refresh if it decides one is due.
    local stale=false now_ts
    now_ts=$(date +%s)
    if [ -n "$last_refresh" ]; then
        local refresh_ts age_days
        refresh_ts=$(date -d "$last_refresh" +%s 2>/dev/null || echo 0)
        age_days=$(( (now_ts - refresh_ts) / 86400 ))
        [ "$age_days" -ge "$STALE_REFRESH_DAYS" ] && stale=true
    fi
    local exp
    exp=$(jwt_exp "$token")
    if [[ "$exp" =~ ^[0-9]+$ ]] && [ "$exp" -gt 0 ] && [ $(( exp - now_ts )) -le "$STALE_EXP_SECONDS" ]; then
        stale=true
    fi

    if [ "$stale" = true ]; then
        CODEX_HOME="$codex_home" timeout 15 codex login status >/dev/null 2>&1 || true
        token=$(jq -r '.tokens.access_token // ""' "$auth_file" 2>/dev/null || echo "$token")
        account_id=$(jq -r '.tokens.account_id // ""' "$auth_file" 2>/dev/null || echo "$account_id")
    fi

    local api_resp
    api_resp=$(curl -s --max-time 5 \
        -H "Authorization: Bearer $token" \
        -H "ChatGPT-Account-Id: $account_id" \
        -H "User-Agent: codex-cli" \
        "https://chatgpt.com/backend-api/wham/usage" 2>/dev/null || echo '{}')

    if echo "$api_resp" | jq -e '.rate_limit' >/dev/null 2>&1; then
        creds_status="ok"
        plan_type=$(echo "$api_resp" | jq -r '.plan_type // "unknown"')
        primary_util=$(echo "$api_resp" | jq -r '.rate_limit.primary_window.used_percent // 0')
        primary_reset=$(echo "$api_resp" | jq -r '.rate_limit.primary_window.reset_at // ""')
        primary_window=$(echo "$api_resp" | jq -r '.rate_limit.primary_window.limit_window_seconds // 0')
        secondary_util=$(echo "$api_resp" | jq -r '.rate_limit.secondary_window.used_percent // 0')
        secondary_reset=$(echo "$api_resp" | jq -r '.rate_limit.secondary_window.reset_at // ""')
        secondary_window=$(echo "$api_resp" | jq -r '.rate_limit.secondary_window.limit_window_seconds // 0')
        credits_balance=$(echo "$api_resp" | jq -r '.credits.balance // "0"')
        credits_has=$(echo "$api_resp" | jq -r '.credits.has_credits // false')
    else
        creds_status="expired"
    fi

    write_out
}

# --- Collect account list ---
ACCOUNT_NAMES=()
ACCOUNT_DIRS=()  # codex home dir per account

# add_account <name> <codex_home_dir>
# First registration of a name wins.
add_account() {
    local name="$1" dir="$2"

    # , | : are output delimiters, they cannot survive in an account name
    name="${name//[,|:]/}"
    [ -n "$name" ] || return 0
    [ -n "$dir" ] || return 0

    case "$dir" in
        [~]/*) dir="${HOME}/${dir#*/}" ;;
        [~]) dir="$HOME" ;;
    esac
    dir="${dir%/}"

    local existing existing_dir
    for existing in "${ACCOUNT_NAMES[@]:-}"; do
        [ "$existing" = "$name" ] && return 0
    done
    for existing_dir in "${ACCOUNT_DIRS[@]:-}"; do
        [ "$existing_dir" = "$dir" ] && return 0
    done

    ACCOUNT_NAMES+=("$name")
    ACCOUNT_DIRS+=("$dir")
}

add_account "default" "${CODEX_HOME:-${HOME}/.codex}"

# Manual entries from plugin settings: "name=/path/to/codex/home", same
# convention as get-claude-usage's manual profile entries.
for arg in "$@"; do
    case "$arg" in
        *=*) add_account "${arg%%=*}" "${arg#*=}" ;;
    esac
done

# --- Fetch usage per account in parallel ---
TMPDIR_ROOT=$(mktemp -d)
trap 'rm -rf "$TMPDIR_ROOT"' EXIT

USAGE_TMPFILES=()
PIDS=()

for idx in "${!ACCOUNT_DIRS[@]}"; do
    usage_tmpf=$(mktemp "$TMPDIR_ROOT/account_XXXXXX")
    USAGE_TMPFILES+=("$usage_tmpf")
    fetch_account_usage "${ACCOUNT_DIRS[$idx]}" "$usage_tmpf" &
    PIDS+=("$!")
done

for pid in "${PIDS[@]:-}"; do
    [ -n "$pid" ] && wait "$pid" || true
done

# --- Read per-account results, build aggregate (default account) + lists ---
PLAN_TYPE="unknown"
PRIMARY_UTIL=0
PRIMARY_RESET=""
PRIMARY_WINDOW_SECONDS=0
SECONDARY_UTIL=0
SECONDARY_RESET=""
SECONDARY_WINDOW_SECONDS=0
CREDITS_BALANCE="0"
CREDITS_HAS="false"
CREDS_STATUS="missing"

ACCOUNT_PLAN_LIST=""
ACCOUNT_PRIMARY_UTIL_LIST=""
ACCOUNT_PRIMARY_RESET_LIST=""
ACCOUNT_SECONDARY_UTIL_LIST=""
ACCOUNT_SECONDARY_RESET_LIST=""
ACCOUNT_CREDITS_BALANCE_LIST=""
ACCOUNT_CREDS_STATUS_LIST=""

for idx in "${!USAGE_TMPFILES[@]}"; do
    usage_tmpf="${USAGE_TMPFILES[$idx]}"
    aname="${ACCOUNT_NAMES[$idx]}"
    [ -f "$usage_tmpf" ] || continue

    a_plan="unknown"
    a_pu=0; a_pr=""; a_pw=0
    a_su=0; a_sr=""; a_sw=0
    a_cb="0"; a_ch="false"; a_cs="missing"

    a_plan=$(grep "^PLAN_TYPE=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo "unknown")
    a_pu=$(grep "^PRIMARY_UTIL=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo 0)
    a_pr=$(grep "^PRIMARY_RESET=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo "")
    a_pw=$(grep "^PRIMARY_WINDOW_SECONDS=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo 0)
    a_su=$(grep "^SECONDARY_UTIL=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo 0)
    a_sr=$(grep "^SECONDARY_RESET=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo "")
    a_sw=$(grep "^SECONDARY_WINDOW_SECONDS=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo 0)
    a_cb=$(grep "^CREDITS_BALANCE=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo "0")
    a_ch=$(grep "^CREDITS_HAS=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo "false")
    a_cs=$(grep "^CREDS_STATUS=" "$usage_tmpf" 2>/dev/null | cut -d= -f2- || echo "missing")

    if [ "$aname" = "default" ]; then
        PLAN_TYPE="$a_plan"
        PRIMARY_UTIL="$a_pu"
        PRIMARY_RESET="$a_pr"
        PRIMARY_WINDOW_SECONDS="$a_pw"
        SECONDARY_UTIL="$a_su"
        SECONDARY_RESET="$a_sr"
        SECONDARY_WINDOW_SECONDS="$a_sw"
        CREDITS_BALANCE="$a_cb"
        CREDITS_HAS="$a_ch"
        CREDS_STATUS="$a_cs"
    fi

    ACCOUNT_PLAN_LIST="${ACCOUNT_PLAN_LIST:+${ACCOUNT_PLAN_LIST},}${aname}:${a_plan}"
    ACCOUNT_PRIMARY_UTIL_LIST="${ACCOUNT_PRIMARY_UTIL_LIST:+${ACCOUNT_PRIMARY_UTIL_LIST},}${aname}:${a_pu}"
    ACCOUNT_PRIMARY_RESET_LIST="${ACCOUNT_PRIMARY_RESET_LIST:+${ACCOUNT_PRIMARY_RESET_LIST},}${aname}:${a_pr}"
    ACCOUNT_SECONDARY_UTIL_LIST="${ACCOUNT_SECONDARY_UTIL_LIST:+${ACCOUNT_SECONDARY_UTIL_LIST},}${aname}:${a_su}"
    ACCOUNT_SECONDARY_RESET_LIST="${ACCOUNT_SECONDARY_RESET_LIST:+${ACCOUNT_SECONDARY_RESET_LIST},}${aname}:${a_sr}"
    ACCOUNT_CREDITS_BALANCE_LIST="${ACCOUNT_CREDITS_BALANCE_LIST:+${ACCOUNT_CREDITS_BALANCE_LIST},}${aname}:${a_cb}"
    ACCOUNT_CREDS_STATUS_LIST="${ACCOUNT_CREDS_STATUS_LIST:+${ACCOUNT_CREDS_STATUS_LIST},}${aname}:${a_cs}"

    rm -f "$usage_tmpf"
done

ACCOUNTS=$(IFS=,; echo "${ACCOUNT_NAMES[*]}")

echo "PLAN_TYPE=${PLAN_TYPE}"
echo "PRIMARY_UTIL=${PRIMARY_UTIL}"
echo "PRIMARY_RESET=${PRIMARY_RESET}"
echo "PRIMARY_WINDOW_SECONDS=${PRIMARY_WINDOW_SECONDS}"
echo "SECONDARY_UTIL=${SECONDARY_UTIL}"
echo "SECONDARY_RESET=${SECONDARY_RESET}"
echo "SECONDARY_WINDOW_SECONDS=${SECONDARY_WINDOW_SECONDS}"
echo "CREDITS_BALANCE=${CREDITS_BALANCE}"
echo "CREDITS_HAS=${CREDITS_HAS}"
echo "CREDS_STATUS=${CREDS_STATUS}"
echo "ACCOUNTS=${ACCOUNTS}"
echo "ACCOUNT_PLAN=${ACCOUNT_PLAN_LIST}"
echo "ACCOUNT_PRIMARY_UTIL=${ACCOUNT_PRIMARY_UTIL_LIST}"
echo "ACCOUNT_PRIMARY_RESET=${ACCOUNT_PRIMARY_RESET_LIST}"
echo "ACCOUNT_SECONDARY_UTIL=${ACCOUNT_SECONDARY_UTIL_LIST}"
echo "ACCOUNT_SECONDARY_RESET=${ACCOUNT_SECONDARY_RESET_LIST}"
echo "ACCOUNT_CREDITS_BALANCE=${ACCOUNT_CREDITS_BALANCE_LIST}"
echo "ACCOUNT_CREDS_STATUS=${ACCOUNT_CREDS_STATUS_LIST}"
